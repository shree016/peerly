# ═════════════════════════════════════════════════════════════════════════════
# Peeerly environment variables
# Copy this file to .env.local and fill in the values.
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# Database (Neon PostgreSQL)
# Create a Neon project, paste its URL here, then run `npm run db:migrate`.
# ─────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────
# Better Auth
# BETTER_AUTH_SECRET: any long random string (run: openssl rand -hex 32)
# BETTER_AUTH_URL: this app's base URL (no trailing slash)
#   production: https://peeerly.tech
# ─────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Sign-up email policy
# Leave empty to allow any email, or set a domain to restrict sign-ups,
# e.g. bmsce.ac.in.
# ─────────────────────────────────────────────
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=bmsce.ac.in

# ─────────────────────────────────────────────
# Google OAuth
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — button is hidden in the UI)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Email (Resend — verification emails + "new question" notifications)
# RESEND_FROM_EMAIL must use a domain verified in Resend.
# ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Peeerly <noreply@peeerly.tech>

# ─────────────────────────────────────────────
# Roles & access (RBAC). Who holds which role is managed at /admin/users.
# NEVER commit real emails — set these only in .env.local / Vercel.
#
# SUPER_ADMIN_EMAILS: owner account(s), always admin, can't be removed or
#   suspended from the UI (comma separated).
# BOOTSTRAP_*: one-time inputs for `npm run roles:bootstrap` (e.g. moving the
#   old quiz-admin list over). Remove them after running the script once.
# ─────────────────────────────────────────────
SUPER_ADMIN_EMAILS=
BOOTSTRAP_ACTIVITY_COORDINATOR_EMAILS=
BOOTSTRAP_FACULTY_EMAILS=

# ─────────────────────────────────────────────
# Quiz + poll realtime (Supabase Realtime only — DB is Neon)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# App URL (join links, QR codes, email links)
# ─────────────────────────────────────────────
# production: https://peeerly.tech
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# OpenAI (quiz AI question generation + participant report feedback)
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embeddings for quiz course materials (RAG). Changing it requires re-indexing materials.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────
# AWS S3 (profile pictures, quiz images, company logos, JD/resource docs,
# private quiz report PDFs).
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
